'use strict';
var elements = document.querySelectorAll('span.population');
var numbers = Array.from(elements).map(function(str) {
    var text = str.textContent.trim();
    return Number(text.replaceAll(',', ''));
});
var totalSum = numbers.reduce(function(acc, cur) {
    return acc + cur;
}, 0);
var average = Math.round(totalSum / numbers.length);
var formatter = new Intl.NumberFormat('en-US');
var formattedTotalSum = formatter.format(totalSum);
var formattedAverage = formatter.format(average);
document.querySelector('span.total-population').textContent = formattedTotalSum;
document.querySelector('span.average-population').textContent = formattedAverage;

